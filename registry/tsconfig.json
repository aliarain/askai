{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": {
      "@/lib/utils": ["registry/stubs/utils.d.ts"],
      "@/components/ui/popover": ["registry/stubs/popover.d.ts"],
      "@/components/ui/askai": ["registry/ui/askai.tsx"],
      "@raptrx/askai": ["src/index.ts"],
      "@raptrx/askai/logos": ["src/brand.ts"]
    }
  },
  "include": ["ui/**/*.tsx", "examples/**/*.tsx", "stubs/*.d.ts"]
}
