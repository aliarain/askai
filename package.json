{
  "name": "@raptrx/askai",
  "version": "2.0.0",
  "description": "Verified AI deep-links and an Ask AI split button for ChatGPT, Claude, Perplexity, Grok and more",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "askai": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./logos": {
      "types": "./dist/logos.d.ts",
      "import": "./dist/logos.mjs",
      "require": "./dist/logos.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "generate:logos": "node scripts/generate-logos.mjs"
  },
  "dependencies": {
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.2.0",
    "eslint": "^8.55.0",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^1.1.0"
  },
  "author": "Ali Arain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliarain/askai.git"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "claude",
    "perplexity",
    "grok",
    "deepseek",
    "mistral",
    "qwen",
    "kimi",
    "prompt",
    "deep-link",
    "ask-ai",
    "react",
    "cli"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
